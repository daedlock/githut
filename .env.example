# GitHub OAuth app credentials
# Local callback URL: http://localhost:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Long random string used to sign OAuth state
OAUTH_STATE_SECRET=

# App origin. For local development this should match the Vite dev URL.
APP_URL=http://localhost:5173

# Cloudflare deploy secrets are configured in GitHub Actions / Wrangler, not committed here:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
